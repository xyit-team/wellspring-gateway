{
    "name": "@xyit-team/wellspring-gateway",
    "version": "0.5.1",
    "description": "Wellspring 网关插件：统一入口、路由、TLS 与统一登录",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/xyit-team/wellspring-gateway.git"
    },
    "homepage": "https://github.com/xyit-team/wellspring-gateway#readme",
    "bugs": {
        "url": "https://github.com/xyit-team/wellspring-gateway/issues"
    },
    "type": "module",
    "main": "index.ts",
    "engines": {
        "node": ">=24"
    },
    "files": [
        "index.ts",
        "src",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "node scripts/run-tests.mjs",
        "build:zip": "node scripts/build-zip.mjs"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@xyit/wellspring": "^1.7.6",
        "pino": "^10.4.0",
        "typescript": "^7.0.2"
    },
    "wellspring": {
        "apiVersion": 1,
        "name": "wellspring-gateway",
        "npm": "@xyit-team/wellspring-gateway",
        "github": "xyit-team/wellspring-gateway",
        "sandbox": {
            "profile": "plugin",
            "network": true,
            "fs": {
                "read": [
                    "${pluginDir}"
                ],
                "write": []
            },
            "hostApi": [
                "logger",
                "fs",
                "event"
            ]
        }
    }
}
